{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minutes-schema.json",
  "title": "结构化总结结构（meeting-notes-expert，会议版章节名）",
  "description": "validate_minutes.py 从总结 md/docx 解析出的结构必须满足本 schema；字段为空表示该节缺失。仅适用会议版章节名，通用总结不强制。",
  "type": "object",
  "required": ["basic_info", "sections"],
  "properties": {
    "basic_info": {
      "type": "object",
      "description": "会议基本信息，键为字段名（会议主题/会议时间/…），值为内容",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sections": {
      "type": "object",
      "required": ["会议结论", "关键决策", "待办事项", "会议内容"],
      "additionalProperties": {"type": "string"},
      "properties": {
        "会议结论": {"type": "string", "minLength": 1},
        "关键决策": {"type": "string", "minLength": 1},
        "待办事项": {"type": "string", "minLength": 1},
        "待定与开放问题": {"type": "string"},
        "上期行动项回顾": {"type": "string"},
        "会议内容": {"type": "string", "minLength": 1}
      }
    },
    "action_items": {
      "type": "array",
      "description": "待办表数据行（不含表头）。status/strength/source 为可选项：旧六列纪要没有这三列，解析为空字符串时不下发对应键。",
      "items": {
        "type": "object",
        "required": ["id", "task", "owner", "due", "priority", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "due": {"type": "string", "minLength": 1},
          "priority": {"enum": ["高", "中", "低", "待定"]},
          "status": {
            "enum": ["未开始", "进行中", "受阻", "完成", "取消", "待定"],
            "description": "执行状态。跨会跟踪靠它区分「还没做」与「做完了」"
          },
          "strength": {
            "enum": ["确定", "软性"],
            "description": "表述强度：确定=会上明确承诺；软性=「尽量／看看能不能／有空时」类。缺省视为未标注"
          },
          "source": {
            "type": "string",
            "description": "原文锚点：会议原文时间戳或逐字引文片段，用于人工核对与出处溯源"
          },
          "note": {"type": "string"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "关键决策条目。text 必填，source 为原文锚点（可空字符串）",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "source": {"type": "string"}
        }
      }
    },
    "decision_texts": {
      "type": "array",
      "description": "决策纯文本（向后兼容：旧消费方读这里，避免被对象化改动打断）",
      "items": {"type": "string", "minLength": 1}
    },
    "document_status": {
      "$ref": "#/$defs/OutputStatus",
      "description": "文档级完整性：complete 全过；degraded 无 FAIL 但有 WARN；failed 有 FAIL"
    },
    "status": {
      "$ref": "#/$defs/OutputStatus",
      "description": "同 document_status，保留旧键名兼容旧消费方"
    },
    "processing_warnings": {
      "type": "array",
      "description": "非致命问题清单，逐条可定位到具体校验步骤",
      "items": {"$ref": "#/$defs/ProcessingWarning"}
    }
  },
  "$defs": {
    "OutputStatus": {
      "type": "string",
      "enum": ["complete", "degraded", "failed"]
    },
    "ProcessingWarning": {
      "type": "object",
      "required": ["step", "reason"],
      "properties": {
        "step": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "message": {"type": ["string", "null"]}
      }
    }
  }
}
